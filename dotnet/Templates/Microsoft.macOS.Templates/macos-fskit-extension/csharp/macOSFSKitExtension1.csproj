<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>TFM</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace Condition="'$(name)' != '$(name{-VALUE-FORMS-}safe_namespace)'">macOSFSKitExtension1</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>true</ImplicitUsings>
    <SupportedOSPlatformVersion>minOSVersion</SupportedOSPlatformVersion>
    <IsAppExtension>True</IsAppExtension>

    <!-- The bundle identifier (aka ApplicationId) for an app extension must be the main app's bundle identifier + ".<something>" -->
    <ApplicationId>com.companyname.macOSApp1.fskitextension</ApplicationId>
  </PropertyGroup>
</Project>
