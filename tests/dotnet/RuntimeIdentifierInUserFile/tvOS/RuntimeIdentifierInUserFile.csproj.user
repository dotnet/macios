<?xml version="1.0" encoding="utf-8"?>
<!-- This file is intentionally checked in: it's the whole point of the test. A '*.csproj.user'
     file is imported after we've computed '_SdkIsSimulator' from the default (simulator)
     RuntimeIdentifier, so setting a device RuntimeIdentifier here makes the build inconsistent,
     and we're expected to show an error saying so. -->
<Project>
	<PropertyGroup>
		<RuntimeIdentifier>tvos-arm64</RuntimeIdentifier>
	</PropertyGroup>
</Project>
