      <Item ItemId=";postActions/addProjectReference/manualInstructions/default/text" ItemType="0" PsrId="306" Leaf="true">
        <Str Cat="Text">
          <Val><![CDATA[The final step is to add a reference to this newly created project in the main app's project file, like this:]A;]A;	<ItemGroup>]A;		<ProjectReference Include="iOSNotificationContentExtension1.csproj">]A;			<IsAppExtension>true</IsAppExtension>]A;		</ProjectReference>]A;	</ItemGroup>]A;]]></Val>
          <Tgt Cat="Text" Stat="Loc" Orig="New">
            <Val><![CDATA[Ostatnim krokiem jest dodanie odwołania do tego nowo utworzonego projektu w pliku projektu głównej aplikacji w następujący sposób:]A;]A;	<ItemGroup>]A;		<ProjectReference Include="iOSNotificationContentExtension1.csproj">]A;			<IsAppExtension>true</IsAppExtension>]A;		</ProjectReference>]A;	</ItemGroup>]A;]]></Val>
          </Tgt>
        </Str>
        <Disp Icon="Str" />
