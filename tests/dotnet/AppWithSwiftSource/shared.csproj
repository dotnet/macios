<?xml version="1.0" encoding="utf-8"?>
<Project>
	<PropertyGroup>
		<OutputType>Exe</OutputType>

		<ApplicationTitle>AppWithSwiftSource</ApplicationTitle>
		<ApplicationId>com.xamarin.appwithswiftsource</ApplicationId>
		<ApplicationVersion>1.0</ApplicationVersion>
	</PropertyGroup>

	<Import Project="../../common/shared-dotnet.csproj" />

	<ItemGroup>
		<Compile Include="../*.cs" />
		<SwiftSource Include="../*.swift" />
		<SwiftSource Include="../OtherModule/*.swift" ModuleName="OtherModule" BridgingHeader="../OtherModule/BridgingHeader.h" AdditionalArguments="-D APP_WITH_SWIFT_SOURCE_DEFINE" />
	</ItemGroup>
</Project>
