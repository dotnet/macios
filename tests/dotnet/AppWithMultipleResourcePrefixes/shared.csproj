<?xml version="1.0" encoding="utf-8"?>
<Project>
	<PropertyGroup>
		<OutputType>Exe</OutputType>

		<ApplicationTitle>AppWithMultipleResourcePrefixes</ApplicationTitle>
		<ApplicationId>com.xamarin.appwithmultipleresourceprefixes</ApplicationId>

		<!-- Use multiple resource prefixes separated by semicolons -->
		<AppBundleResourcePrefix>Resources;PlatformResources</AppBundleResourcePrefix>
	</PropertyGroup>

	<Import Project="../../common/shared-dotnet.csproj" />

	<ItemGroup>
		<Compile Include="../*.cs" />

		<PartialAppManifest Include="../shared.plist" />
	</ItemGroup>
</Project>
