  <ItemGroup>
    <None Include="../../dotnet/targets/Microsoft.MaciOS.Analyzers.targets" Link="Microsoft.MaciOS.Analyzers.targets" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
