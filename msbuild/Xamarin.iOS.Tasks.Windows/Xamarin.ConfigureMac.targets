<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
	<PropertyGroup>
		<_ConfigureMacTaskFramework Condition="'$(_UseDesktopTaskAssemblies)' == 'true'">netstandard2.0</_ConfigureMacTaskFramework>
		<_ConfigureMacTaskFramework Condition="'$(_UseDesktopTaskAssemblies)' != 'true'">net12.0</_ConfigureMacTaskFramework>
	</PropertyGroup>

	<UsingTask Runtime="$(_TaskRuntime)" TaskName="Xamarin.MacDev.Tasks.Messaging.GenerateBuildSessionId" AssemblyFile="$(_TaskAssemblyName)" />
	<UsingTask Runtime="$(_TaskRuntime)" TaskName="Xamarin.Messaging.Remote.Tasks.ConfigureMac" AssemblyFile="$(MSBuildThisFileDirectory)ConfigureMac/$(_ConfigureMacTaskFramework)/Xamarin.Messaging.Remote.Tasks.dll" />
	<UsingTask Runtime="$(_TaskRuntime)" TaskName="Xamarin.Messaging.Remote.Tasks.StreamDeviceLog" AssemblyFile="$(MSBuildThisFileDirectory)ConfigureMac/$(_ConfigureMacTaskFramework)/Xamarin.Messaging.Remote.Tasks.dll" />
	<UsingTask Runtime="$(_TaskRuntime)" TaskName="Xamarin.Messaging.Remote.Tasks.SubscribeToDeviceUpdates" AssemblyFile="$(MSBuildThisFileDirectory)ConfigureMac/$(_ConfigureMacTaskFramework)/Xamarin.Messaging.Remote.Tasks.dll" />

	<Target Name="ConfigureMac" Returns="$(RemoteDotNetRoot)">
		<PropertyGroup>
			<ServerSshPort Condition="'$(ServerSshPort)' == ''">22</ServerSshPort>
			<ResetRemoteCache Condition="'$(ResetRemoteCache)' == ''">false</ResetRemoteCache>
			<OverwriteRemoteNuGetConfig Condition="'$(OverwriteRemoteNuGetConfig)' == ''">false</OverwriteRemoteNuGetConfig>
		</PropertyGroup>

		<GenerateBuildSessionId
			MessagingVersion="$(MessagingVersion)"
			ProjectFullPath="$(MSBuildProjectFullPath)"
			ProjectName="$(MSBuildProjectName)"
			TargetFramework="$(TargetFramework)"
			VisualStudioProcessId="$(VisualStudioProcessId)">
			<Output TaskParameter="AgentVersion" PropertyName="_ConfigureMacAgentVersion" />
		</GenerateBuildSessionId>

		<Xamarin.Messaging.Remote.Tasks.ConfigureMac
			BrokerAgentZip="$(MSBuildThisFileDirectory)Broker.zip"
			BuildAgentZip="$(MSBuildThisFileDirectory)Build.zip"
			DotNetSdkFeed="$(DotNetSdkFeed)"
			DotNetSdkVersion="$(NETCoreSdkVersion)"
			IosWorkloadManifestVersion="$(IosWorkloadManifestVersion)"
			LocalDotNetRoot="$(NetCoreRoot)"
			MessagingVersion="$(_ConfigureMacAgentVersion)"
			OverwriteRemoteNuGetConfig="$(OverwriteRemoteNuGetConfig)"
			ProjectFile="$(MSBuildProjectFullPath)"
			RemoteBasePath="$(RemoteBasePath)"
			RemoteNuGetConfigFile="$(RemoteNuGetConfigFile)"
			ResetRemoteCache="$(ResetRemoteCache)"
			ServerAddress="$(ServerAddress)"
			ServerFingerprint="$(ServerFingerprint)"
			ServerPasswordFile="$(ServerPasswordFile)"
			ServerSshPort="$(ServerSshPort)"
			ServerUser="$(ServerUser)"
			SSHKey="$(SSHKey)"
			SSHPassPhraseFile="$(SSHPassPhraseFile)"
			XcodeLocation="$(XcodeLocation)">
			<Output TaskParameter="RemoteArchitecture" PropertyName="RemoteArchitecture" />
			<Output TaskParameter="RemoteBasePath" PropertyName="ConfiguredRemoteBasePath" />
			<Output TaskParameter="RemoteDotNetRoot" PropertyName="RemoteDotNetRoot" />
			<Output TaskParameter="RemoteHomeDirectory" PropertyName="RemoteHomeDirectory" />
		</Xamarin.Messaging.Remote.Tasks.ConfigureMac>

		<Error Condition="!$(RemoteDotNetRoot.StartsWith('/'))" Text="ConfigureMac did not return an absolute remote .NET SDK directory." />
		<PropertyGroup>
			<_ConfiguredMacInCurrentInvocation>true</_ConfiguredMacInCurrentInvocation>
		</PropertyGroup>
	</Target>

	<!-- Long-running target: it only returns once the caller sends Stop or closes the pipe. See docs/building-apps/build-targets.md. -->
	<Target Name="SubscribeToDeviceUpdates">
		<Error Condition="'$(DeviceUpdatesPipeName)' == ''" Text="The 'DeviceUpdatesPipeName' property must be set to the name of a named pipe created by the caller." />
		<PropertyGroup>
			<ServerSshPort Condition="'$(ServerSshPort)' == ''">22</ServerSshPort>
			<!-- Only pass the RuntimeIdentifier if the user set it, so that the snapshots match what ComputeAvailableDevices returns. -->
			<_DeviceUpdatesRuntimeIdentifier Condition="'$(_XamarinUsingDefaultRuntimeIdentifier)' != 'true'">$(RuntimeIdentifier)</_DeviceUpdatesRuntimeIdentifier>
		</PropertyGroup>
		<Xamarin.Messaging.Remote.Tasks.SubscribeToDeviceUpdates
			Configuration="$(Configuration)"
			PipeName="$(DeviceUpdatesPipeName)"
			ProjectFile="$(MSBuildProjectFullPath)"
			RemoteBasePath="$(RemoteBasePath)"
			RemoteDotNetRoot="$(RemoteDotNetRoot)"
			RuntimeIdentifier="$(_DeviceUpdatesRuntimeIdentifier)"
			ServerAddress="$(ServerAddress)"
			ServerFingerprint="$(ServerFingerprint)"
			ServerPasswordFile="$(ServerPasswordFile)"
			ServerSshPort="$(ServerSshPort)"
			ServerUser="$(ServerUser)"
			SessionId="$(BuildSessionId)"
			SSHKey="$(SSHKey)"
			SSHPassPhraseFile="$(SSHPassPhraseFile)"
			TargetFramework="$(TargetFramework)"
			XcodeLocation="$(XcodeLocation)"
		/>
	</Target>

	<!-- Long-running target: it only returns once the caller sends Stop or closes the pipe. See docs/building-apps/build-targets.md. -->
	<Target Name="StreamDeviceLog">
		<Error Condition="'$(DeviceLogPipeName)' == ''" Text="The 'DeviceLogPipeName' property must be set to the name of a named pipe created by the caller." />
		<Error Condition="'$(Device)' == ''" Text="The 'Device' property must be set to the UDID or name of the device or simulator to stream the log from." />
		<PropertyGroup>
			<ServerSshPort Condition="'$(ServerSshPort)' == ''">22</ServerSshPort>
		</PropertyGroup>
		<Xamarin.Messaging.Remote.Tasks.StreamDeviceLog
			Device="$(Device)"
			PipeName="$(DeviceLogPipeName)"
			RemoteBasePath="$(RemoteBasePath)"
			RemoteDotNetRoot="$(RemoteDotNetRoot)"
			ServerAddress="$(ServerAddress)"
			ServerFingerprint="$(ServerFingerprint)"
			ServerPasswordFile="$(ServerPasswordFile)"
			ServerSshPort="$(ServerSshPort)"
			ServerUser="$(ServerUser)"
			SessionId="$(BuildSessionId)"
			SSHKey="$(SSHKey)"
			SSHPassPhraseFile="$(SSHPassPhraseFile)"
			XcodeLocation="$(XcodeLocation)"
		/>
	</Target>
</Project>
