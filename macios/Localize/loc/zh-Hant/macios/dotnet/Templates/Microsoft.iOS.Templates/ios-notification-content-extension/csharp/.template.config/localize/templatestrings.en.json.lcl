      <Item ItemId=";postActions/addProjectReference/description" ItemType="0" PsrId="306" Leaf="true">
        <Str Cat="Text">
          <Val><![CDATA[Add project reference in main app's project file]]></Val>
          <Tgt Cat="Text" Stat="Loc" Orig="New">
            <Val><![CDATA[在主要應用程式的專案檔案中新增專案參考內容]]></Val>
