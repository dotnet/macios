<?xml version="1.0" encoding="utf-8"?>
<Project>
	<PropertyGroup>
		<OutputType>Exe</OutputType>

		<ApplicationTitle>AppWithOnDemandResources</ApplicationTitle>
		<ApplicationId>com.xamarin.appwithondemandresources</ApplicationId>
	</PropertyGroup>

	<Import Project="../../common/shared-dotnet.csproj" />

	<ItemGroup>
		<Compile Include="../*.cs" />

		<!-- An on-demand resource: tagged with ResourceTags so it's routed into an asset pack. -->
		<BundleResource Include="../SoundBank.bin" LogicalName="SoundBank.bin" ResourceTags="MusicTag" />
	</ItemGroup>
</Project>
