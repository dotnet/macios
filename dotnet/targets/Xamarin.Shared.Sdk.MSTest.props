<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

	<!-- Default properties for MSTest runner projects on Apple platforms -->
	<PropertyGroup>
		<!-- MSTest runner projects need the interpreter because test platform assemblies fail AOT compilation -->
		<MtouchInterpreter Condition="'$(MtouchInterpreter)' == ''">all</MtouchInterpreter>
		<!-- MSTest adapter has duplicate publish output files, suppress the error -->
		<ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
		<!-- Apple platforms provide their own entry point (UIApplication.Main, NSApplication.Main, etc.) -->
		<GenerateTestingPlatformEntryPoint Condition="'$(GenerateTestingPlatformEntryPoint)' == ''">false</GenerateTestingPlatformEntryPoint>
		<!-- Suppress trimmer warnings from test framework dependencies (e.g. Microsoft.ApplicationInsights) -->
		<SuppressTrimAnalysisWarnings Condition="'$(SuppressTrimAnalysisWarnings)' == ''">true</SuppressTrimAnalysisWarnings>
	</PropertyGroup>
	<ItemGroup>
		<!-- Disable ANSI escape codes in MSTest output, as they appear as garbled text in simulator/device logs -->
		<RuntimeEnvironmentVariable Include="NO_COLOR" Value="1" />
	</ItemGroup>

</Project>
