      <Item ItemId=";postActions/addProjectReference/manualInstructions/default/text" ItemType="0" PsrId="306" Leaf="true">
        <Str Cat="Text">
          <Val><![CDATA[The final step is to add a reference to this newly created project in the main app's project file, like this:]A;]A;	<ItemGroup>]A;		<ProjectReference Include="iOSNotificationServiceExtension1.csproj">]A;			<IsAppExtension>true</IsAppExtension>]A;		</ProjectReference>]A;	</ItemGroup>]A;]]></Val>
          <Tgt Cat="Text" Stat="Loc" Orig="New">
            <Val><![CDATA[El paso final consiste en agregar una referencia a este proyecto recién creado en el archivo de proyecto de la aplicación principal, de la siguiente manera:]A;]A;	<ItemGroup>]A;		<ProjectReference Include="iOSNotificationServiceExtension1.csproj">]A;			<IsAppExtension>true</IsAppExtension>]A;		</ProjectReference>]A;	</ItemGroup>]A;]]></Val>
          </Tgt>
        </Str>
        <Disp Icon="Str" />
      </Item>
