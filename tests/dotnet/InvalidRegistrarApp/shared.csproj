<?xml version="1.0" encoding="utf-8"?>
<Project>
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<ApplicationTitle>InvalidRegistrarApp</ApplicationTitle>
		<ApplicationId>com.xamarin.invalidregistrarapp</ApplicationId>
		<ExcludeNUnitLiteReference>true</ExcludeNUnitLiteReference>
		<ExcludeTouchUnitReference>true</ExcludeTouchUnitReference>

		<Registrar>dynamic</Registrar>
		<MtouchLink>None</MtouchLink>
		<LinkMode>None</LinkMode>
	</PropertyGroup>

	<Import Project="../../common/shared-dotnet.csproj" />

	<ItemGroup>
		<Compile Include="../*.cs" />
	</ItemGroup>
</Project>
